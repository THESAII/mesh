
Header
  CHECK KEYWORDS Warn
  Mesh DB "." "."
  Include Path ""
  Results Directory ""
End

Simulation
  Max Output Level = 7
  Coordinate System = Cartesian
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Transient
  
  Output Intervals(5) = integer 1 1 1 1 1
  Timestep intervals(5) = integer 10 9 3 3 99
  Timestep Sizes(5) = real  1e-7 1e-6 3e-5 3e-4 0.001
  
  Timestepping Method = BDF
  BDF Order = 2
  Solver Input File = case.sif
  Post File = case.vtu
End

Constants
  Gravity(4) = 0 -1 0 9.82
  Stefan Boltzmann = 5.670374419e-08
  Permittivity of Vacuum = 8.85418781e-12
  Permeability of Vacuum = 1.25663706e-6
  Boltzmann Constant = 1.380649e-23
  Unit Charge = 1.6021766e-19
End

Body 1
  Target Bodies(1) = 1
  Name = "Body 1"
  Equation = 1
  Material = 1
End
        
Body 2
  Target Bodies(1) = 2
  Name = "Body 2"
  Equation = 1
  Material = 2
End
        
Body 3
  Target Bodies(1) = 3
  Name = "Body 3"
  Equation = 2
  Body Force = 1
  Material = 3
End
        
Body 4
  Target Bodies(1) = 4
  Name = "Body 4"
  Equation = 1
  Material = 4
End
        
Body 5
  Target Bodies(1) = 5
  Name = "Body 5"
  Equation = 1
  Material = 5
End
        
Body 6
  Target Bodies(1) = 6
  Name = "Body 6"
  Equation = 1
  Material = 6
End
        
Body 7
  Target Bodies(1) = 7
  Name = "Body 7"
  Equation = 1
  Material = 7
End
        
Solver 3
  Equation = MgDynPost
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Calculate Current Density = True
  Discontinuous Bodies = True
  Exec Solver = Before Saving
  Stabilize = True
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-7
  Nonlinear System Max Iterations = 20
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 1
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
  BiCGstabl polynomial degree = 2
  Linear System Preconditioning = ILU0
  Linear System ILUT Tolerance = 1.0e-3
  Linear System Abort Not Converged = False
  Linear System Residual Output = 10
  Linear System Precondition Recompute = 1
End

Solver 2
  Equation = CoilSolver
  Coil Closed = True
  Fix Input Current Density = True
  Normalize Coil Current = True
  Procedure = "CoilSolver" "CoilSolver"
  Narrow Interface = True
  Desired Coil Current = 620
  Coil Normal(3) = 0 1 0
  Exec Solver = Before Simulation
  Stabilize = True
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-7
  Nonlinear System Max Iterations = 20
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 1
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
  BiCGstabl polynomial degree = 2
  Linear System Preconditioning = ILU0
  Linear System ILUT Tolerance = 1.0e-3
  Linear System Abort Not Converged = False
  Linear System Residual Output = 10
  Linear System Precondition Recompute = 1
End

Solver 1
  Equation = MgDyn
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Use Piola Transform = Logical True
  Quadratic Approximation = Logical True
  Use Elemental CoilCurrent = True
  Stabilize = True
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-7
  Nonlinear System Max Iterations = 1
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 1  
  Linear System Solver = Iterative
  
  Linear System Iterative Method = BiCGStabl

  Linear System Max Iterations = 3000
  Linear System Convergence Tolerance = Variable Timestep
    Real MATC "if(tx<=1) 0.5e-3; else 1e-10"
  BiCGstabl polynomial degree = 4

  Linear System Preconditioning = none

  Linear System Robust = True
  Linear System Robust Tolerance = 1e-7
  Linear System Robust Ratio = Variable Timestep
    Real MATC "if(tx<=24) 1e4; else 1e6"
  Linear System Robust Start Iteration = 300
  Linear System Robust Relaxed = Logical True
  
  Linear System ILUT Tolerance = 1.0e-3
  Linear System Abort Not Converged = False
  Linear System Residual Output = 10
  Linear System Precondition Recompute = 1
  Linear System GCR Restart = 400
End

Equation 1
  Name = "Equation 1"
  Active Solvers(2) = 1 3
End

Equation 2
  Name = "Equation 2"
  Active Solvers(3) = 2 1 3
End

Material 1
  Name = "Air"
  Relative Permittivity = 1
  Electric Conductivity = 0
  Relative Permeability = 1
End
        
Material 2
  Name = "Ferrite"
  Relative Permittivity = 1
  Electric Conductivity = 833330.0
  Relative Permeability = 500
End
        
Material 3
  Name = "D"
  Relative Permittivity = 1
  Relative Permeability = 1
End
        
Material 4
  Name = "P"
  Relative Permittivity = 1
  Relative Permeability = 1
End
        
Material 5
  Name = "G1"
  Relative Permittivity = 1
  Electric Conductivity = 5000000.0
  Relative Permeability = 75
End
        
Material 6
  Name = "G2"
  Relative Permittivity = 1
  Electric Conductivity = 5500000.0
  Relative Permeability = 80
End
        
Material 7
  Name = "G3"
  Relative Permittivity = 1
  Electric Conductivity = 5500000.0
  Relative Permeability = 80
End
        
Body Force 1
  Name = "BodyForce 1"
  Current Density Multiplier = Variable Time
  Real
0 0
5e-07 0.5
1e-06 1
0.2 1
0.2000005 0.5
0.20000099999999998 0
0.4 0
  End
End

Initial Condition 1
  AV {e} = 0
End

Boundary Condition 1
  Target Boundaries(1) = 8 
  Name = "BoundaryCondition 1"
  AV {e} = 0.0
  Potential = 0
End
